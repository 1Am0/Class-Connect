# Local-only demo. Production fails closed if this is enabled.
DEMO_MODE=true
ENABLE_SIMULATOR=true
# Public Supabase URL (preferred) or Vercel/Supabase integration URL.
NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_URL=
# Public/browser key precedence:
# 1) NEXT_PUBLIC_SUPABASE_ANON_KEY (legacy, preferred for compatibility)
# 2) NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY
# 3) SUPABASE_PUBLISHABLE_KEY
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_PUBLISHABLE_KEY=
# Server-only admin key precedence:
# 1) SUPABASE_SECRET_KEY
# 2) SUPABASE_SERVICE_ROLE_KEY (legacy)
# Never expose these with NEXT_PUBLIC_.
# SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional local demo hardware token; use at least 32 random characters.
DEMO_DEVICE_KEY=

# Student school email domain: a six-digit ID 123456 becomes
# 123456@students.example.edu. Public (used in the browser) and baked in at
# build time, so redeploy after changing it. Defaults to students.example.edu.
NEXT_PUBLIC_STUDENT_EMAIL_DOMAIN=students.example.edu

# Student QR check-in (hosted Supabase only). Use a separate Google Web client.
# This client ID is public; the signing secret must remain server-only.
GOOGLE_STUDENT_CLIENT_ID=
# Must equal NEXT_PUBLIC_STUDENT_EMAIL_DOMAIN for Google sign-in to turn on.
GOOGLE_STUDENT_DOMAIN=
# Set this only if Google reports a different Workspace hosted domain (hd claim).
GOOGLE_STUDENT_HOSTED_DOMAIN=
QR_CHECKIN_SECRET=
